    },
    {
      "source": "/paymentplan",
      "destination": "/nathiagali/payment-plan",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/nathiagali/blog",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/nathiagali/blog",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/nathiagali/blog/:path*",
