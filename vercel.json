    {
      "source": "/blogs/:path*",
      "destination": "/nathiagali/blog/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/nathiagali/about",
      "permanent": true
    },
    {
      "source": "/amenities",
      "destination": "/nathiagali/amenities",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/nathiagali/contact-us",
      "permanent": true
    },
    {
      "source": "/floor-plans",
      "destination": "/nathiagali/floor-plans",
      "permanent": true
    },
    {
      "source": "/progress",
      "destination": "/nathiagali/progress",
      "permanent": true
    },
    {
      "source": "/co-ownership",
      "destination": "/nathiagali/co-ownership",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sereneheightsnathiagali.com" }],
      "destination": "https://www.sereneheightsnathiagali.com/:path*",
      "permanent": true
    },
      {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sereneheightsgroup.com" }],
      "destination": "https://www.sereneheightsgroup.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/nathiagali/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
