# === Current production (root domain) ===
NEXT_PUBLIC_SITE_URL=https://www.sereneheightsnathiagali.com
# Leave empty so the app stays at /
NEXT_PUBLIC_BASE_PATH=

# === After cutover to group domain ===
# NEXT_PUBLIC_SITE_URL=https://www.sereneheightsgroup.com/nathiagali
# NEXT_PUBLIC_BASE_PATH=/nathiagali
# Allow group + Nathia hosts (Nathia hosts are also hardcoded as allowed)
# NEXT_PUBLIC_ALLOWED_HOSTS=www.sereneheightsgroup.com,sereneheightsgroup.com,www.sereneheightsnathiagali.com,sereneheightsnathiagali.com
# Only enable when ready to 301 the old domain entirely to group.com:
# NEXT_PUBLIC_LEGACY_REDIRECT_HOSTS=www.sereneheightsnathiagali.com,sereneheightsnathiagali.com

# === Lead forms → Serene CRM (server-side only; never NEXT_PUBLIC_) ===
CRM_WEBSITE_LEADS_URL=https://<crm-api-host>/api/v1/webhooks/website
# Must equal WEBSITE_LEADS_WEBHOOK_SECRET on the CRM server. Generate: openssl rand -hex 32
# Never commit the real value.
CRM_WEBSITE_LEADS_SECRET=

# Cloudflare Turnstile bot check (dash.cloudflare.com → Turnstile). Off when unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Docker/self-hosted only: header your reverse proxy overwrites with the visitor IP
# (e.g. nginx `proxy_set_header X-Real-IP $remote_addr;`). Leave unset on Vercel.
# CLIENT_IP_HEADER=x-real-ip
